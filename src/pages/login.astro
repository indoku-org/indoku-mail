---
import Layout from "../layouts/Layout.astro"
import Login from "../components/Login"
import { getSession } from "../lib/session"
const add = Astro.url.searchParams.get("add") === "1"
// Already signed in: go to the inbox, unless the person came here to add another account.
if (getSession(Astro.cookies.get("sid")?.value) && !add) return Astro.redirect("/u/0/inbox")
---
<Layout title={add ? "Add account · Indoku Mail" : "Sign in · Indoku Mail"}><Login add={add} client:only="react" /></Layout>
