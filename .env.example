# IMAP host MUST present a valid TLS cert for that exact hostname.
# (imap.indoku.org currently serves a mismatched cert; server.griv.co.id and webmail.indoku.org are valid.)
IMAP_HOST=server.griv.co.id
IMAP_PORT=993
SMTP_HOST=smtp.indoku.org
SMTP_PORT=465
# Required, 32+ random chars. Generate: openssl rand -base64 48
SESSION_SECRET=
